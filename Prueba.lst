....................    for (i=0;i<USB_MAX_NUM_INTERFACES;i++)  
0314:  MOVLB  1
0316:  CLRF   x3D
0318:  MOVF   x3D,F
031A:  BNZ   0330
....................       USB_Interface[i] = 0;   //reset each interface to default 
031C:  CLRF   03
031E:  MOVF   x3D,W
0320:  ADDLW  2C
0322:  MOVWF  FE9
0324:  MOVLW  00
0326:  ADDWFC 03,W
0328:  MOVWF  FEA
032A:  CLRF   FEF
....................  
....................   #IF USB_HID_BOOT_PROTOCOL 
....................    for (i=0;i<USB_NUM_HID_INTERFACES; i++) 
....................       hid_protocol[i] = 1; 
....................   #endif 
....................  
....................   #if USB_CDC_DEVICE 
032C:  INCF   x3D,F
032E:  BRA    0318
....................    usb_cdc_init(); 
....................   #endif 
....................  
....................    USB_stack_status.curr_config = 0;      //unconfigured device 
0330:  CLRF   21
....................  
....................    USB_stack_status.status_device = 1;    //previous state.  init at none 
0332:  MOVLW  01
0334:  MOVWF  22
....................    USB_stack_status.dev_req = NONE;       //previous token request state.  init at none 
0336:  CLRF   20
0338:  MOVLB  0
033A:  GOTO   034E (RETURN)
.................... } 
