....................  
.................... /// BEGIN USB Token, standard and HID request handler (part of ISR) 
....................  
.................... // see usb.h for documentation 
.................... void usb_token_reset(void)  
.................... { 
....................    unsigned int i; 
....................  
....................    usb_getdesc_len = 0; 
*
02F4:  CLRF   31
02F6:  CLRF   30
....................     
....................    for (i=0;i<USB_MAX_NUM_INTERFACES;i++)  
