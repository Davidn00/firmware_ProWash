.................... /******************************************************************************/ 
.................... void usb_isr_rst(void)  
.................... { 
....................    debug_usb_control(debug_putc,"-R-"); 
....................  
....................    UEIE = 0; 
*
033E:  CLRF   F6B
....................    UIE = 0; 
0340:  CLRF   F69
....................    UEIR = 0; 
0342:  CLRF   F6A
....................    UIR = 0; 
0344:  CLRF   F68
....................  
....................    UADDR = 0; 
0346:  CLRF   F6E
....................     
....................    UEP(0) = ENDPT_DISABLED; 
0348:  CLRF   F70
....................  
....................    usb_disable_endpoints(); 
034A:  RCALL  02F2
....................     
....................    usb_token_reset(); 
034C:  BRA    0310
....................  
....................    UEP(0) = ENDPT_CONTROL | 0x10; 
034E:  MOVLW  16
0350:  MOVWF  F70
....................  
....................    while (UIR_TRN)  
0352:  BTFSS  F68.3
0354:  BRA    035A
....................    { 
....................       usb_clear_trn(); 
0356:  RCALL  0004
0358:  BRA    0352
....................    } 
....................  
....................  
....................    UEIE = 0x9F; 
035A:  MOVLW  9F
035C:  MOVWF  F6B
....................    UIE = STANDARD_INTS & ~__USB_UIF_ACTIVE; 
035E:  MOVLW  3D
0360:  MOVWF  F69
....................  
....................    UCON_PKTDIS = 0; //SIE token and packet processing enabled 
0362:  BCF    F6D.4
....................  
....................    usb_init_ep0_setup(); 
0364:  RCALL  0210
....................  
....................    usb_state = USB_STATE_DEFAULT; //put usb mcu into default state 
0366:  MOVLW  03
0368:  MOVWF  25
036A:  GOTO   0DF2 (RETURN)
.................... } 
