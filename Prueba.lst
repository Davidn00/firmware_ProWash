....................          } 
.................... } 
.................... void contador_s ()                                 //contador de 1s 
.................... { 
....................       do 
....................       { 
....................         for(int contador=0; contador<6; contador++) 
....................         {  
....................         lcd_gotoxy(12,3); 
....................         printf (lcd_putc,"%dSeg ",contador); 
....................         delay_ms(255); 
....................         } 
....................       }while (contador==6); 
.................... } 
