....................  
.................... #ifndef debug_usb_packet 
....................    #define debug_usb_packet(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o) 
....................    #define debug_display_ram(len, ptr) 
.................... #else 
....................    void debug_display_ram(unsigned int8 len, unsigned int8 *ptr)  
....................    { 
