.................... /************************************************************** 
.................... /* usb_endpoint_is_valid(endpoint) 
.................... /* 
.................... /* Input: endpoint - endpoint to check. 
.................... /*                   bit 7 is direction (set is IN, clear is OUT) 
.................... /* 
.................... /* Output: TRUE if endpoint is valid, FALSE if not 
.................... /* 
.................... /* Summary: Checks the dynamic configuration to see if requested 
.................... /*          endpoint is a valid endpoint. 
.................... /***************************************************************/ 
.................... int1 usb_endpoint_is_valid(unsigned int8 endpoint)  
.................... { 
....................    int1 direction; 
....................     
....................    direction = bit_test(endpoint,7); 
*
0250:  MOVLB  1
0252:  BCF    x4A.0
0254:  BTFSC  x49.7
0256:  BSF    x4A.0
....................     
....................    endpoint &= 0x7F; 
0258:  BCF    x49.7
....................     
....................    if (endpoint > 16) 
025A:  MOVF   x49,W
025C:  SUBLW  10
025E:  BC    0266
....................       return(FALSE); 
0260:  MOVLW  00
0262:  MOVWF  01
0264:  BRA    029A
....................     
....................    if (direction) { //IN 
0266:  BTFSS  x4A.0
0268:  BRA    0284
....................       return(usb_ep_tx_type[endpoint] != USB_ENABLE_DISABLED); 
026A:  CLRF   03
026C:  MOVF   x49,W
026E:  MOVLB  0
0270:  RCALL  00DA
0272:  SUBLW  FF
0274:  BNZ   027A
0276:  MOVLW  00
0278:  BRA    027C
027A:  MOVLW  01
027C:  MOVWF  01
027E:  MOVLB  1
0280:  BRA    029A
....................    } 
0282:  BRA    029A
....................    else {   //OUT 
....................       return(usb_ep_rx_type[endpoint] != USB_ENABLE_DISABLED); 
0284:  CLRF   03
0286:  MOVF   x49,W
0288:  MOVLB  0
028A:  RCALL  00DA
028C:  SUBLW  FF
028E:  BNZ   0294
0290:  MOVLW  00
0292:  BRA    0296
0294:  MOVLW  01
0296:  MOVWF  01
0298:  MOVLB  1
....................    } 
029A:  MOVLB  0
029C:  RETURN 0
.................... } 
