0CE8:  BNZ   0D34
....................       { 
....................          if ((EP_BDxST_I(0) & 0x80) != 0x00) 
0CEA:  MOVLB  4
0CEC:  MOVF   x04,W
0CEE:  ANDLW  80
0CF0:  BZ    0CF4
....................             EP_BDxST_I(0)=0;   // return the in buffer to us (dequeue any pending requests) 
0CF2:  CLRF   x04
....................  
....................          //debug_usb(debug_putc,"(%U) ", EP_BDxCNT_O(0)); 
....................          //debug_display_ram(EP_BDxCNT_O(0), usb_ep0_rx_buffer); 
....................  
....................          usb_isr_tok_setup_dne(); 
0CF4:  MOVLB  0
0CF6:  BRA    0A38
....................  
....................          UCON_PKTDIS=0;       // UCON,PKT_DIS ; Assuming there is nothing to dequeue, clear the packet disable bit 
0CF8:  BCF    F6D.4
....................  
....................          //if setup_0_tx_size==0xFF - stall ep0 (unhandled request) (see usb_request_stall()) 
....................          //if setup_0_tx_size==0xFE - get EP0OUT ready for a data packet, leave EP0IN alone (see usb_request_get_data()) 
....................          //else setup_0_tx_size=size of response, get EP0OUT ready for a setup packet, mark EPOIN ready for transmit (see usb_request_send_response()) 
....................          if (__setup_0_tx_size == 0xFF) 
0CFA:  INCFSZ 26,W
0CFC:  BRA    0D0C
....................             usb_flush_out(0, USB_DTS_STALL); 
0CFE:  MOVLB  2
0D00:  CLRF   xC8
0D02:  MOVLW  03
0D04:  MOVWF  xC9
0D06:  MOVLB  0
0D08:  RCALL  0A6A
0D0A:  BRA    0D30
....................          else  
....................          { 
....................             usb_flush_out(0, USB_DTS_TOGGLE); 
0D0C:  MOVLB  2
0D0E:  CLRF   xC8
0D10:  MOVLW  02
0D12:  MOVWF  xC9
0D14:  MOVLB  0
0D16:  RCALL  0A6A
....................             if (__setup_0_tx_size != 0xFE) 
0D18:  MOVF   26,W
0D1A:  SUBLW  FE
0D1C:  BZ    0D30
....................                usb_flush_in(0 ,__setup_0_tx_size, USB_DTS_USERX); 
0D1E:  MOVLB  2
0D20:  CLRF   xC8
0D22:  CLRF   xCA
0D24:  MOVFF  26,2C9
0D28:  MOVLW  04
0D2A:  MOVWF  xCB
0D2C:  MOVLB  0
0D2E:  RCALL  0B74
....................          } 
....................          //why was this here? 
....................          //UCON_PKTDIS=0;       // UCON,PKT_DIS ; Assuming there is nothing to dequeue, clear the packet disable bit 
....................       } 
0D30:  BRA    0D6A
0D32:  MOVLB  2
....................       else if (pidKey == USB_PIC_PID_OUT)  
0D34:  MOVF   xC7,W
0D36:  SUBLW  04
0D38:  BNZ   0D6C
....................       { 
....................          usb_isr_tok_out_dne(0); 
0D3A:  CLRF   xC8
0D3C:  MOVLB  0
0D3E:  RCALL  0C6A
....................          usb_flush_out(0, USB_DTS_TOGGLE); 
0D40:  MOVLB  2
0D42:  CLRF   xC8
0D44:  MOVLW  02
0D46:  MOVWF  xC9
0D48:  MOVLB  0
0D4A:  RCALL  0A6A
....................          if ((__setup_0_tx_size!=0xFE) && (__setup_0_tx_size!=0xFF)) 
0D4C:  MOVF   26,W
0D4E:  SUBLW  FE
0D50:  BZ    0D6A
0D52:  INCFSZ 26,W
0D54:  BRA    0D58
0D56:  BRA    0D6A
....................          { 
....................             usb_flush_in(0,__setup_0_tx_size,USB_DTS_DATA1);   //send response (usually a 0len) 
0D58:  MOVLB  2
0D5A:  CLRF   xC8
0D5C:  CLRF   xCA
0D5E:  MOVFF  26,2C9
0D62:  MOVLW  01
0D64:  MOVWF  xCB
0D66:  MOVLB  0
0D68:  RCALL  0B74
0D6A:  MOVLB  2
....................          } 
....................       } 
....................       //else 
....................       //{ 
....................       //   debug_usb(debug_putc, "!!! "); 
....................       //} 
....................    } 
0D6C:  BRA    0DB2
....................    else if (USTATCopy == USTAT_IN_E0)  
0D6E:  MOVF   24,W
0D70:  SUBLW  04
0D72:  BNZ   0D98
....................    {    
....................       //pic -> host transfer completed 
....................       //EP_BDxST_I(0) = EP_BDxST_I(0) & 0xC3;   //clear up any BDSTAL confusion 
....................       __setup_0_tx_size = 0xFF; 
0D74:  SETF   26
....................       usb_isr_tok_in_dne(0); 
0D76:  CLRF   xC8
0D78:  MOVLB  0
0D7A:  RCALL  0C9C
....................       if (__setup_0_tx_size!=0xFF) 
0D7C:  INCFSZ 26,W
0D7E:  BRA    0D82
0D80:  BRA    0D94
....................          usb_flush_in(0, __setup_0_tx_size, USB_DTS_TOGGLE); 
0D82:  MOVLB  2
0D84:  CLRF   xC8
0D86:  CLRF   xCA
0D88:  MOVFF  26,2C9
0D8C:  MOVLW  02
0D8E:  MOVWF  xCB
0D90:  MOVLB  0
0D92:  RCALL  0B74
....................       else 
....................       { 
....................          //usb_init_ep0_setup(); //REMOVED JUN/9/2009 
....................       }   
....................    } 
0D94:  BRA    0DB0
0D96:  MOVLB  2
....................    else  
....................    { 
....................       if (!bit_test(USTATCopy, 2))  
0D98:  BTFSC  24.2
0D9A:  BRA    0DA8
....................       { 
....................          //EP_BDxST_O(en) = EP_BDxST_O(en) & 0xC3;   //clear up any BDSTAL confusion 
....................          usb_isr_tok_out_dne(en); 
0D9C:  MOVFF  2C6,2C8
0DA0:  MOVLB  0
0DA2:  RCALL  0C6A
....................       } 
0DA4:  BRA    0DB0
0DA6:  MOVLB  2
....................       else  
....................       { 
....................          //EP_BDxST_I(en) = EP_BDxST_I(en) & 0xC3;   //clear up any BDSTAL confusion 
....................          usb_isr_tok_in_dne(en); 
0DA8:  MOVFF  2C6,2C8
0DAC:  MOVLB  0
0DAE:  RCALL  0C9C
0DB0:  MOVLB  2
....................       } 
....................    } 
0DB2:  MOVLB  0
0DB4:  GOTO   0E1E (RETURN)
.................... } 
